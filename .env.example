# Copy this file to .env and fill in your own key. .env is git-ignored; never commit it.
#
# Any OpenAI-compatible chat API works. Default: Google Gemini free tier.
# Get a free key at https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your-key-here
LLM_MODEL=gemini-3.5-flash

# Alternatives (swap all three lines):
# Groq (free tier):   LLM_BASE_URL=https://api.groq.com/openai/v1      LLM_MODEL=<a model from console.groq.com/docs/models>
# Ollama (local):     LLM_BASE_URL=http://localhost:11434/v1           LLM_API_KEY=ollama   LLM_MODEL=qwen2.5-coder:7b
